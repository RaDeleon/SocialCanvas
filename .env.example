# Copy to .env. Development works without this file in a local demo workspace.
APP_URL=http://localhost:5173
PORT=3001
HOST=127.0.0.1
DEMO_MODE=true
# Required in production; at least 12 characters. No default in production.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Meta > Instagram > API setup with Instagram login > Business login settings
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
DATABASE_PATH=data/socialcanvas.sqlite
# When running a modified version, point to the exact corresponding source.
SOURCE_URL=https://github.com/RaDeleon/SocialCanvas
# Set only when behind exactly one trusted reverse proxy.
TRUST_PROXY=0
